# Claude / Anthropic
# Modelos vigentes: https://docs.claude.com/en/docs/about-claude/models
# Sonnet 5 por defecto: costo/calidad adecuado para las tareas estructuradas de los 5 agentes
# (extraccion, scoring, copywriting corto) dentro del tope de MAX_USD_PER_RUN.
# Cambia a claude-opus-5 si prefieres priorizar calidad sobre costo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Tope de gasto por corrida, en USD. El orquestador se detiene antes de excederlo.
MAX_USD_PER_RUN=0.50
